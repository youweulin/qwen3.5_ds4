+
+static std::string slot_metadata_filename(const std::string & filename) {
+    return filename + ".meta.json";
+}
+
+static std::string slot_hash_text(const std::string & text) {
+    uint64_t hash = 1469598103934665603ULL; // FNV-1a 64-bit offset basis
+    for (unsigned char c : text) {
+        hash ^= c;
+        hash *= 1099511628211ULL;
+    }
+
+    std::ostringstream out;
+    out << std::hex << std::setfill('0') << std::setw(16) << hash;
+    return out.str();
+}
+
+static std::string slot_hash_json(const json & data) {
+    return slot_hash_text(data.dump());
+}
+
+static std::string slot_model_meta_val(const llama_model * model, const char * key) {
+    char small[256];
+    const int32_t len = llama_model_meta_val_str(model, key, small, sizeof(small));
+    if (len < 0) {
+        return "";
+    }
+    if ((size_t) len < sizeof(small)) {
+        return std::string(small);
+    }
+
+    std::vector<char> buf((size_t) len + 1);
+    llama_model_meta_val_str(model, key, buf.data(), buf.size());
+    return std::string(buf.data());
+}
