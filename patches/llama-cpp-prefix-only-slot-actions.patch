+static bool slot_metadata_write(
+        const std::string & filepath,
+        const std::string & filename,
+        int id_slot,
+        const std::string & payload_scope,
+        const json & runtime_identity,
+        const std::string & runtime_identity_hash,
+        size_t n_tokens,
+        size_t n_bytes,
+        double t_ms) {
+    json metadata = {
+        { "schema",         "llama.cpp-slot-artifact-metadata-v1" },
+        { "filename",       filename },
+        { "payload_scope",  payload_scope },
+        { "runtime_identity_hash", runtime_identity_hash },
+        { "runtime_identity", runtime_identity },
+        { "id_slot",        id_slot },
+        { "n_tokens",       n_tokens },
+        { "n_bytes",        n_bytes },
+        { "created_unix",   (int64_t) std::time(nullptr) },
+        { "timings", {
+            { "save_ms", t_ms },
+        }},
+    };
+
+    std::ofstream out(slot_metadata_filepath(filepath), std::ios::out | std::ios::trunc);
+    if (!out.good()) {
+        return false;
+    }
+    out << metadata.dump(2) << '\n';
+    return out.good();
+}
+
+static bool slot_metadata_read(const std::string & filepath, json & metadata) {
+    std::ifstream in(slot_metadata_filepath(filepath));
+    if (!in.good()) {
+        return false;
+    }
+    metadata = json::parse(in, nullptr, false);
+    return !metadata.is_discarded();
+}
