{
  "name": "AI - Lead Intake CRM Follow-up",
  "nodes": [
    {
      "parameters": {
        "path": "lead-intake",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "id": "webhook-lead-intake",
      "name": "Webhook: Lead Form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.LOCAL_AI_BASE_URL || 'http://host.docker.internal:18180/v1/chat/completions'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: $env.LOCAL_AI_MODEL || 'qwen3.5:4b', temperature: 0.1, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Use policy n8n_templates/policies/lead-intake-crm-followup.md. Return valid JSON only.' }, { role: 'user', content: JSON.stringify($json.body || $json) } ] } }}"
      },
      "id": "ai-lead-score",
      "name": "Local AI: Score Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "workflow", "type": "string", "value": "lead-intake-crm-followup" },
            { "name": "review_status", "type": "string", "value": "needs_review" },
            { "name": "ai_result", "type": "string", "value": "={{$json.choices?.[0]?.message?.content || JSON.stringify($json)}}" },
            { "name": "created_at", "type": "string", "value": "={{$now.toISO()}}" }
          ]
        }
      },
      "id": "set-lead-row",
      "name": "Build CRM Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "={{$env.REVIEW_SHEET_ID}}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "columns": { "mappingMode": "autoMapInputData" }
      },
      "id": "sheet-leads",
      "name": "Google Sheets: CRM Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [780, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, status: 'lead_queued_for_review' } }}"
      },
      "id": "respond-lead",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1040, 0]
    }
  ],
  "connections": {
    "Webhook: Lead Form": { "main": [[{ "node": "Local AI: Score Lead", "type": "main", "index": 0 }]] },
    "Local AI: Score Lead": { "main": [[{ "node": "Build CRM Row", "type": "main", "index": 0 }]] },
    "Build CRM Row": { "main": [[{ "node": "Google Sheets: CRM Leads", "type": "main", "index": 0 }]] },
    "Google Sheets: CRM Leads": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
