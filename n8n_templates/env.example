# n8n Local vs Cloud AI Benchmark Environment
# Copy values into n8n / Zeabur environment variables.
# Do not commit real API keys.

# ------------------------------------------------------------
# Local AI
# ------------------------------------------------------------

# If n8n is running in Docker/Zeabur and your AI server is on your Mac,
# this may need to be changed to a tunnel/private-network URL.
LOCAL_AI_BASE_URL=http://host.docker.internal:18180/v1/chat/completions
LOCAL_AI_MODEL=qwen3.5:4b

# Default local marginal token cost is 0 because hardware is already owned.
# If you want to include electricity/hardware amortization, fill your estimate.
LOCAL_AI_INPUT_USD_PER_1K=0
LOCAL_AI_OUTPUT_USD_PER_1K=0

# ------------------------------------------------------------
# Cloud AI, OpenAI-compatible chat completions endpoint
# ------------------------------------------------------------

# Example for OpenAI:
# CLOUD_AI_BASE_URL=https://api.openai.com/v1/chat/completions
# CLOUD_AI_MODEL=gpt-4.1-mini
#
# Example for Gemini OpenAI-compatible endpoint, if enabled in your setup:
# CLOUD_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# CLOUD_AI_MODEL=gemini-3.1-flash-lite
# Alternative model observed in model list:
# CLOUD_AI_MODEL_ALT=gemma-4-26b-a4b-it
#
# Leave empty until you decide which provider to test.
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL=
CLOUD_AI_MODEL_ALT=
CLOUD_AI_API_KEY=

# Fill current provider pricing manually.
# Unit: USD per 1K tokens.
# Example only, replace with current pricing:
CLOUD_AI_INPUT_USD_PER_1K=0
CLOUD_AI_OUTPUT_USD_PER_1K=0
CLOUD_AI_ALT_INPUT_USD_PER_1K=0
CLOUD_AI_ALT_OUTPUT_USD_PER_1K=0

# ------------------------------------------------------------
# Google Sheets review / benchmark output
# ------------------------------------------------------------

# Sheet tabs expected by templates:
# - AI Benchmarks
# - Content Review
# - Leads
# - Support Review
# - Daily Digest
# - AI Trend Review
# - Review Replies
REVIEW_SHEET_ID=

# ------------------------------------------------------------
# Common workflow settings
# ------------------------------------------------------------

BRAND_NAME=
TIMEZONE=Asia/Taipei
